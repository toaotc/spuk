{% extends 'base.html.twig' %}

{% block main_content %}
    <div class="flex items-center justify-center">
        <div class="stats max-xs:stats-vertical shadow bg-base-200">
            <div class="stat place-items-center">
                <div class="stat-title text-secondary">
                    <i class="fa-solid fa-people-group fa-2xl"></i>
                </div>
                <div class="stat-value">{{ guardianRepository.count }}</div>
                <div class="stat-desc">
                    {{ 'Active'|trans }}: {{ guardianRepository.count({'active': true}) }}
                </div>
                <div class="stat-desc">
                    {{ 'Inactive'|trans }}: {{ guardianRepository.count({'active': false}) }}
                </div>
            </div>

            <div class="stat place-items-center">
                <div class="stat-title text-secondary">
                    <i class="fa-solid fa-children fa-2xl"></i>
                </div>
                <div class="stat-value">{{ kidRepository.count }}</div>
                <div class="stat-desc">
                    {{ 'Active'|trans }}: {{ kidRepository.count({'active': true}) }}
                    &bullet;
                    {{ 'Inactive'|trans }}: {{ kidRepository.count({'active': false}) }}
                </div>
                <div class="stat-desc">
                    {% for kid_group in kidGroupRepository.findAll %}
                        {{ not loop.first ? '&bullet;' }}
                        {{ kid_group.name }}: {{ kid_group.kids(true)|length }}
                    {% endfor %}
                </div>
            </div>

            <div class="stat place-items-center">
                <div class="stat-title text-secondary">
                    <i class="fa-solid fa-calendar-days fa-2xl"></i>
                </div>
                <div class="stat-value">{{ appointmentRepository.count }}</div>
                <div class="stat-desc">
                    {{ 'Active'|trans }}: {{ appointmentRepository.count({'active': true}) }}
                </div>
                <div class="stat-desc">
                    {{ 'Inactive'|trans }}: {{ appointmentRepository.count({'active': false}) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
