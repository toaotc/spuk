<form method="post" action="{{ path('app_appointment_delete', {'id': appointment.id}) }}" onsubmit="return confirm('{{ 'Are you sure you want to delete "%name%"?'|trans({'%name%': appointment.title}) }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ appointment.id) }}">
    <button class="btn btn-error btn-outline">{{ 'Delete'|trans }}</button>
</form>
