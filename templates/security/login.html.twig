{% extends 'base.html.twig' %}

{% block title %}{{ 'Log in'|trans }}{% endblock %}

{% block main_content %}
    <div class="flex justify-center">
        {{ form_start(form, {attr: {class: 'card'}}) }}
            <div class="card-body">
                <h1 class="card-title">{{ 'Please sign in'|trans }}</h1>

                {% if error %}
                    <div role="alert" class="alert alert-error alert-soft mb-3">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {{ form_widget(form) }}
                {{ form_rest(form) }}

                <div class="card-actions">
                    <button class="btn btn-lg btn-primary" type="submit">
                        {{ 'Sign in'|trans }}
                    </button>
                </div>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
