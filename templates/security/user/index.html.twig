{% extends 'base.html.twig' %}

{%- block title -%}{{ 'User'|trans }}{%- endblock -%}

{%- block main_header_title -%}{{ 'User'|trans }}{%- endblock -%}

{%- block main_header_button -%}
    {%- if is_granted('ROLE_CREATE_USER') -%}
        <a class="btn btn-outline" href="{{ path('app_security_user_new') }}">{{ 'Create %name%'|trans({'%name%': 'user'|trans}) }}</a>
    {%- endif -%}
{%- endblock -%}

{% block main_content %}
    <div class="overflow-x-auto rounded bg-base-200">
        <div class="flex flex-wrap items-baseline justify-between p-3">
            {{ knp_pagination_render(pager) }}
        </div>
        <table class="table table-pin-rows table-pin-cols [&_*]:align-baseline">
            <thead>
                <tr>
                    <th></th>
                    <td>{{ knp_pagination_sortable(pager, 'Username'|trans, 'user.username') }}</td>
                    <td colspan="5">{{ 'Roles'|trans }}</td>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for user in pager %}
                <tr>
                    <th>{{ loop.index + (pager.itemNumberPerPage * (pager.currentPageNumber - 1)) }}</th>
                    <td>{{ user.username }}</td>
                    {% for section in ['APPOINTMENT', 'GUARDIAN', 'KID', 'KID_GROUP', 'USER'] %}
                    <td>
                        {% for action in ['ROLE_CREATE', 'ROLE_READ', 'ROLE_UPDATE', 'ROLE_DELETE'] %}
                            <div>
                                {% for role in user.roles|filter(r => r !== 'ROLE_USER')|filter(r => r ends with section)|filter(r => r starts with action) -%}
                                    <span class="badge badge-soft whitespace-nowrap my-0.5">{{ role|trans }}</span>
                                {% endfor %}
                            </div>
                        {% endfor %}
                    </td>
                    {% endfor %}
                    <th>
                        {% if is_granted('ROLE_UPDATE_USER') %}
                            <a class="btn btn-xs btn-square tooltip tooltip-left" data-tip="{{ 'Edit'|trans }}" href="{{ path('app_security_user_edit', {id: user.id}) }}">
                                <i class="fa fa-edit"></i>
                            </a>
                        {% endif %}
                    </th>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8">{{ 'No results found'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
