<form method="post" action="{{ path('app_kid_delete', {'id': kid.id}) }}" onsubmit="return confirm('{{ 'Are you sure you want to delete "%name%"?'|trans({'%name%': kid.name}) }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ kid.id) }}">
    <button class="btn btn-error btn-outline">{{ 'Delete'|trans }}</button>
</form>
