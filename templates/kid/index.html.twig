{% extends 'base.html.twig' %}

{% block title %}{{ 'Kids'|trans }}{% endblock %}

{%- block main_header_title -%}{{ 'Kids'|trans }}{%- endblock -%}

{%- block main_header_button -%}
    {%- if is_granted('ROLE_CREATE_KID') -%}
        <a class="btn btn-outline" href="{{ path('app_kid_new') }}">{{ 'Create %name%'|trans({'%name%': 'kid'|trans}) }}</a>
    {%- endif -%}
{%- endblock -%}

{% block main_content %}
    <div class="overflow-x-auto rounded bg-base-200">
        <div class="flex flex-wrap items-baseline justify-between p-3">
            {{ knp_pagination_render(pager) }}
        </div>
        <table class="table table-pin-rows table-pin-cols [&_*]:align-baseline">
            <thead>
                <tr>
                    <th></th>
                    <td>{{ knp_pagination_sortable(pager, 'Name'|trans, 'kid.name') }}</td>
                    <td>{{ knp_pagination_sortable(pager, 'Kid group'|trans, 'kid_group.name') }}</td>
                    <td>{{ 'Guardians'|trans }}</td>
                    <td>{{ knp_pagination_sortable(pager, 'Active'|trans, 'kid.active') }}</td>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for kid in pager %}
                <tr>
                    <th>{{ loop.index + (pager.itemNumberPerPage * (pager.currentPageNumber - 1)) }}</th>
                    <td>{{ kid.name }}</td>
                    <td>
                        {%- if is_granted('ROLE_UPDATE_KID_GROUP') -%}
                            <a href="{{ path('app_kidgroup_edit', {id: kid.kidGroup.id}) }}" class="btn btn-outline btn-xs whitespace-nowrap my-0.5">{{ kid.kidGroup.name }}</a>
                        {%- endif -%}
                    </td>
                    <td>
                        {%- for guardian in kid.guardians
                            |filter((g) => g.active)
                            |sort((a, b) => a.name <=> b.name)
                        %}
                            {% if is_granted('ROLE_UPDATE_GUARDIAN') -%}
                                <a href="{{ path('app_guardian_edit', {id: guardian.id}) }}" class="btn btn-outline btn-xs whitespace-nowrap my-0.5">{{ guardian.name }}</a>
                            {%- endif -%}
                        {%- endfor -%}
                    </td>
                    <td><input type="checkbox" class="toggle toggle-xs" disabled {{ kid.active ? 'checked'}} /></td>
                    <th>
                        {%- if is_granted('ROLE_UPDATE_KID') -%}
                            <a class="btn btn-xs btn-neutral" href="{{ path('app_kid_edit', {'id': kid.id}) }}">{{ 'Edit'|trans }}</a>
                        {%- endif -%}
                    </th>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">{{ 'No results found'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
