{% extends 'base.html.twig' %}

{% block title %}{{ 'Guardians'|trans }}{% endblock %}

{%- block main_header_title -%}
    <i class="fas fa-people-group"></i>
    {{ 'Guardians'|trans }}
{%- endblock -%}

{%- block main_header_button -%}
    {%- if is_granted(constant('App\\Entity\\Security\\Roles::CREATE_GUARDIAN')) -%}
        <a class="btn btn-outline" href="{{ path('app_guardian_new') }}">{{ 'Create %name%'|trans({'%name%': 'guardian'|trans}) }}</a>
    {%- endif -%}
{%- endblock -%}

{% block main_content %}
    <div class="overflow-x-auto rounded bg-base-200">
        <div class="flex flex-wrap items-baseline justify-between p-3">
            {{ knp_pagination_render(pager) }}
        </div>
        <table class="table table-pin-rows table-pin-cols [&_*]:align-baseline">
            <thead>
                <tr>
                    <th></th>
                    <td>{{ knp_pagination_sortable(pager, 'Name'|trans, 'guardian.name') }}</td>
                    <td>{{ 'Calendar'|trans }}</td>
                    <td>{{ 'Kids'|trans }}</td>
                    <td>{{ knp_pagination_sortable(pager, 'Active'|trans, 'guardian.active') }}</td>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for guardian in pager %}
                <tr>
                    <th>{{ loop.index + (pager.itemNumberPerPage * (pager.currentPageNumber - 1)) }}</th>
                    <td>{{ guardian.name }}</td>
                    <td>
                        <a
                            class="btn btn-square btn-xs tooltip my-0.5"
                            data-tip="{{ 'Show calendar'|trans }}"
                            href="{{ path('app_calendar_show', {'_format': 'html', 'uuid': guardian.uuid}) }}"
                        >
                            <i class="fa-regular fa-address-card"></i>
                        </a>
                        <a
                            class="btn btn-square btn-xs tooltip my-0.5"
                            data-tip="{{ 'Link to calendars ICS-file'|trans }}"
                            href="{{ path('app_calendar_show', {'_format': 'ics', 'uuid': guardian.uuid}) }}"
                            onclick="navigator.clipboard.writeText(this.href); alert('{{ 'Link was copied to clipboard'|trans }}'); return false;"
                        >
                            <i class="fa-regular fa-calendar-xmark"></i>
                        </a>
                    </td>
                    <td>
                        {%- for kid in guardian.kids
                            |filter((k) => k.active)
                            |sort((a, b) => a.name <=> b.name)
                        %}
                            {% if is_granted(constant('App\\Entity\\Security\\Roles::UPDATE_KID')) -%}
                                <a href="{{ path('app_kid_edit', {id: kid.id}) }}" class="btn btn-outline btn-xs whitespace-nowrap my-0.5">{{ kid.name }}</a>
                            {%- endif -%}
                        {%- endfor -%}
                    </td>
                    <td><input type="checkbox" class="toggle toggle-xs" disabled {{ guardian.active ? 'checked'}} /></td>
                    <th>
                        {%- if is_granted(constant('App\\Entity\\Security\\Roles::UPDATE_GUARDIAN')) -%}
                            <a class="btn btn-xs btn-square tooltip tooltip-left" data-tip="{{ 'Edit'|trans }}" href="{{ path('app_guardian_edit', {'id': guardian.id}) }}">
                                <i class="fa fa-edit"></i>
                            </a>
                        {%- endif -%}
                    </th>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">{{ 'No results found'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
