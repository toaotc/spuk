{% extends 'base.html.twig' %}

{% block title %}{{ 'Guardians'|trans }}{% endblock %}

{%- block main_header_title -%}{{ 'Guardians'|trans }}{%- endblock -%}

{%- block main_header_button -%}
    {%- if is_granted('ROLE_CREATE_GUARDIAN') -%}
        <a class="btn btn-outline" href="{{ path('app_guardian_new') }}">{{ 'Create %name%'|trans({'%name%': 'guardian'|trans}) }}</a>
    {%- endif -%}
{%- endblock -%}

{% block main_content %}
    <div class="overflow-x-auto rounded bg-base-200">
        <div class="flex flex-wrap items-baseline justify-between p-3">
            {{ knp_pagination_render(pager) }}
        </div>
        <table class="table table-pin-rows table-pin-cols [&_*]:align-baseline">
            <thead>
                <tr>
                    <th></th>
                    <th>{{ knp_pagination_sortable(pager, 'Name'|trans, 'guardian.name') }}</th>
                    <th>{{ 'Calendar'|trans }}</th>
                    <th>{{ 'Kids'|trans }}</th>
                    <th>{{ knp_pagination_sortable(pager, 'Active'|trans, 'guardian.active') }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for guardian in pager %}
                <tr>
                    <th>{{ loop.index }}</th>
                    <td>{{ guardian.name }}</td>
                    <td>
                        <a
                            class="btn btn-square btn-xs tooltip"
                            data-tip="{{ 'Show calendar'|trans }}"
                            href="{{ path('app_calendar_show', {'_format': 'html', 'uuid': guardian.uuid}) }}"
                        >
                            <svg fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M544 144C552.8 144 560 151.2 560 160L560 480C560 488.8 552.8 496 544 496L96 496C87.2 496 80 488.8 80 480L80 160C80 151.2 87.2 144 96 144L544 144zM96 96C60.7 96 32 124.7 32 160L32 480C32 515.3 60.7 544 96 544L544 544C579.3 544 608 515.3 608 480L608 160C608 124.7 579.3 96 544 96L96 96zM240 312C270.9 312 296 286.9 296 256C296 225.1 270.9 200 240 200C209.1 200 184 225.1 184 256C184 286.9 209.1 312 240 312zM208 352C163.8 352 128 387.8 128 432C128 440.8 135.2 448 144 448L336 448C344.8 448 352 440.8 352 432C352 387.8 316.2 352 272 352L208 352zM408 208C394.7 208 384 218.7 384 232C384 245.3 394.7 256 408 256L488 256C501.3 256 512 245.3 512 232C512 218.7 501.3 208 488 208L408 208zM408 304C394.7 304 384 314.7 384 328C384 341.3 394.7 352 408 352L488 352C501.3 352 512 341.3 512 328C512 314.7 501.3 304 488 304L408 304z"/></svg>
                        </a>
                        <a
                            class="btn btn-square btn-xs tooltip"
                            data-tip="{{ 'Link to calendars .ics-file'|trans }}"
                            href="{{ path('app_calendar_show', {'_format': 'ics', 'uuid': guardian.uuid}) }}"
                            onclick="navigator.clipboard.writeText(this.href); alert('{{ 'Link was copied to clipboard'|trans }}'); return false;"
                        >
                            <svg fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M216 64C229.3 64 240 74.7 240 88L240 128L400 128L400 88C400 74.7 410.7 64 424 64C437.3 64 448 74.7 448 88L448 128L480 128C515.3 128 544 156.7 544 192L544 480C544 515.3 515.3 544 480 544L160 544C124.7 544 96 515.3 96 480L96 192C96 156.7 124.7 128 160 128L192 128L192 88C192 74.7 202.7 64 216 64zM480 496C488.8 496 496 488.8 496 480L496 416L408 416L408 496L480 496zM496 368L496 288L408 288L408 368L496 368zM360 368L360 288L280 288L280 368L360 368zM232 368L232 288L144 288L144 368L232 368zM144 416L144 480C144 488.8 151.2 496 160 496L232 496L232 416L144 416zM280 416L280 496L360 496L360 416L280 416zM216 176L160 176C151.2 176 144 183.2 144 192L144 240L496 240L496 192C496 183.2 488.8 176 480 176L216 176z"/></svg>
                        </a>
                    </td>
                    <td>
                        {%- for kid in guardian.kids
                            |filter((k) => k.active)
                            |sort((a, b) => a.name <=> b.name)
                        %}
                            {% if is_granted('ROLE_UPDATE_KID') -%}
                                <a href="{{ path('app_kid_edit', {id: kid.id}) }}" class="btn btn-outline btn-xs whitespace-nowrap mb-1">{{ kid.name }}</a>
                            {%- endif -%}
                        {%- endfor -%}
                    </td>
                    <td><input type="checkbox" class="toggle toggle-xs" disabled {{ guardian.active ? 'checked'}} /></td>
                    <th>
                        {%- if is_granted('ROLE_UPDATE_GUARDIAN') -%}
                            <a class="btn btn-xs btn-neutral" href="{{ path('app_guardian_edit', {'id': guardian.id}) }}">{{ 'Edit'|trans }}</a>
                        {%- endif -%}
                    </th>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">{{ 'No results found'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
