<!DOCTYPE html>
<html lang="{{ app.locale|lower|replace({'_': '-'}) }}">
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="msapplication-tap-highlight" content="no" />
        <meta name="viewport" content="user-scalable=no, initial-scale=1, maximum-scale=1, minimum-scale=1, width=device-width" />
        <title>Schlossgeisters persönlicher Unternehmungskalender - {% block title %}SPUK{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,{{ '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M168.1 531.1L156.9 540.1C153.7 542.6 149.8 544 145.8 544C136 544 128 536 128 526.2L128 256C128 150 214 64 320 64C426 64 512 150 512 256L512 526.2C512 536 504 544 494.2 544C490.2 544 486.3 542.6 483.1 540.1L471.9 531.1C458.5 520.4 439.1 522.1 427.8 535L397.3 570C394 573.8 389.1 576 384 576C378.9 576 374.1 573.8 370.7 570L344.1 539.5C331.4 524.9 308.7 524.9 295.9 539.5L269.3 570C266 573.8 261.1 576 256 576C250.9 576 246.1 573.8 242.7 570L212.2 535C200.9 522.1 181.5 520.4 168.1 531.1zM288 256C288 238.3 273.7 224 256 224C238.3 224 224 238.3 224 256C224 273.7 238.3 288 256 288C273.7 288 288 273.7 288 256zM384 288C401.7 288 416 273.7 416 256C416 238.3 401.7 224 384 224C366.3 224 352 238.3 352 256C352 273.7 366.3 288 384 288z"/></svg>'|escape('html') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="flex flex-col min-h-screen max-h-screen bg-base-100">
        <div class="max-xs:collapse shadow-sm w-full z-100">
            <input id="navbar-1-toggle" class="peer hidden" type="checkbox" />
            <label for="navbar-1-toggle" class="fixed inset-0 hidden max-xs:peer-checked:block"></label>
            <div class="collapse-title navbar px-5">
                <div class="navbar-start">
                    <label for="navbar-1-toggle" class="btn btn-square xs:hidden mr-3">
                        <i class="fa-solid fa-bars"></i>
                    </label>
                    <a href="{{ path('app_home') }}" class="font-medium">
                        <span class="min-lg:hidden font-bold">SPUK</span>
                        <span class="max-lg:hidden">Schlossgeisters persönlicher Unternehmungskalender</span>
                    </a>
                </div>
                <div class="navbar-center hidden xs:flex">
                    <ul class="menu menu-horizontal">
                        {% set menu_config = [
                            {
                                active_prefix: 'app_guardian_',
                                icon_class: 'fa-people-group',
                                role: constant('App\\Entity\\Security\\Roles::READ_GUARDIAN'),
                                route: 'app_guardian_index',
                                title: 'Guardians'|trans,
                            },
                            {
                                active_prefix: 'app_kid_',
                                icon_class: 'fa-children',
                                role: constant('App\\Entity\\Security\\Roles::READ_KID'),
                                route: 'app_kid_index',
                                title: 'Kids'|trans,
                            },
                            {
                                active_prefix: 'app_kidgroup_',
                                icon_class: 'fa-users-viewfinder',
                                role: constant('App\\Entity\\Security\\Roles::READ_KID_GROUP'),
                                route: 'app_kidgroup_index',
                                title: 'Kid groups'|trans,
                            },
                            {
                                active_prefix: 'app_appointment_',
                                icon_class: 'fa-calendar-days',
                                role: constant('App\\Entity\\Security\\Roles::READ_APPOINTMENT'),
                                route: 'app_appointment_index',
                                title: 'Appointments'|trans,
                            },
                            {
                                active_prefix: 'app_security_user_',
                                icon_class: 'fa-user-group',
                                role: constant('App\\Entity\\Security\\Roles::READ_USER'),
                                route: 'app_security_user_index',
                                title: 'Users'|trans,
                            },
                        ] %}
                        {% set menu -%}
                            {%- for mc in menu_config %}
                                {% if is_granted(mc.role) -%}
                                    <li class="{{ app.current_route starts with mc.active_prefix ? 'menu-active' }}">
                                        <a href="{{ path(mc.route) }}" class="min-xs:max-md:tooltip tooltip-bottom tooltip-start" data-tip="{{ mc.title }}">
                                            <i class="fa-solid {{ mc.icon_class }}"></i>
                                            <span class="min-xs:max-md:hidden">{{ mc.title }}</span>
                                        </a>
                                    </li>{%- endif %}
                            {% endfor -%}
                        {%- endset %}
                        {{ menu|raw }}
                    </ul>
                </div>
                <div class="navbar-end">
                    <ul class="menu menu-horizontal pr-0">
                        {%- if app.user -%}
                            <li>
                                <details class="dropdown dropdown-end">
                                    <summary>
                                        <i class="fa-solid fa-user"></i>{{ app.user.username }}
                                    </summary>
                                    <ul class="dropdown-content bg-base-100 rounded-t-none z-1000 mt-0">
                                        <li>
                                            <a href="{{ logout_path() }}">
                                                {{ 'Log out'|trans }}
                                                <i class="fa-solid fa-right-from-bracket"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </details>
                            </li>
                        {%- endif -%}
                    </ul>
                </div>
            </div>

            <div class="collapse-content xs:hidden">
                <ul class="menu">
                    {{ menu|raw }}
                </ul>
            </div>
        </div>

        <div class="flex-grow overflow-y-auto bg-base-300">
            {%- block body %}
                {%- block main -%}
                    {%- block main_header -%}
                        <div class="flex justify-between items-center px-5 py-3 fixed glass inset-x-0 z-10">
                            <h1 class="text-2xl">{%- block main_header_title '' -%}</h1>
                            <div>{%- block main_header_button '' -%}</div>
                        </div>
                    {%- endblock -%}
                    <div class="px-5 pb-5 mt-20">
                        {%- block main_content '' -%}
                    </div>
                {%- endblock -%}
            {%- endblock -%}
        </div>
    </body>
</html>
